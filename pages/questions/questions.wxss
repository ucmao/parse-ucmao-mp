/* ========== 顶部：马卡龙浅色渐变，面积加大 ========== */
.header {
  position: relative;
  padding: 56rpx 32rpx 64rpx;
  background: linear-gradient(160deg, #f5e6ff 0%, #e8f4fd 50%, #fff0f5 100%);
  margin-bottom: 0;
}

.header-text {
  display: block;
  text-align: center;
  color: #333333;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin: 0;
}

/* ========== 页面主体（左右留白由 .container 提供，不覆盖） ========== */
.page-body {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f8f9fb;
  box-sizing: border-box;
}

/* ========== 搜索框 ========== */
.search-wrap {
  padding: 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.search-clear {
  font-size: 40rpx;
  color: #999;
  padding: 0 8rpx;
  line-height: 1;
}

/* ========== 区块标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin: 32rpx 0 20rpx;
  padding-left: 8rpx;
}

/* ========== 宫格卡片（常用 4 个） ========== */
.grid-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.grid-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.grid-card-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  border-radius: 50%;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.grid-card-text {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 分类 Tab ========== */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.category-tab.active {
  color: #002fa7;
  background: rgba(0, 47, 167, 0.08);
  font-weight: 500;
}

/* ========== FAQ 列表（简约卡片流） ========== */
.qa-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.qa-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: none;
}

.question-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  min-height: 48rpx;
}

.question-num-wrap {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 50%;
}

.question-num {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.question-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.4;
}

.chevron-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chevron {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
  transform: rotate(0deg);
  transition: transform 0.25s ease;
  display: inline-block;
}

.chevron-down {
  transform: rotate(90deg);
}

.answer-wrap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.answer-visible {
  max-height: 2000rpx;
}

.answer-inner {
  padding: 0 24rpx 28rpx 88rpx;
  border-top: 1rpx solid #f0f0f0;
}

.answer-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

.bottom-spacer {
  height: 120rpx;
}

/* ========== 底部悬浮：联系客服（毛玻璃 + 克莱因蓝） ========== */
.contact-float {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.contact-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background: #002fa7;
  border: none;
  border-radius: 50rpx;
}

.contact-button::after {
  border: none;
}
