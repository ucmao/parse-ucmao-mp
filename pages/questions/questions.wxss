/* ========== 顶部：渐变顶到状态栏/导航栏 ========== */
.header-wrap {
  background: linear-gradient(160deg, #f5e6ff 0%, #e8f4fd 50%, #fff0f5 100%);
  margin-bottom: 0;
  padding-bottom: 32rpx;
}

.custom-nav {
  width: 100%;
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
}

.nav-bar-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-arrow {
  font-size: 48rpx;
  font-weight: 300;
  color: #333333;
  line-height: 1;
}

.nav-placeholder {
  width: 80rpx;
}

.nav-title-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

/* ========== 页面主体（左右留白由 .container 提供，不覆盖） ========== */
.page-body {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f8f9fb;
  box-sizing: border-box;
}

/* ========== 搜索框 ========== */
.search-wrap {
  padding: 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-placeholder {
  color: #999;
}

.search-clear {
  font-size: 40rpx;
  color: #999;
  padding: 0 8rpx;
  line-height: 1;
}

/* ========== 区块标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin: 32rpx 0 20rpx;
  padding-left: 8rpx;
}

/* ========== 宫格卡片（常用 4 个） ========== */
.grid-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

/* 卡片：奶油浮起感 */
.grid-card {
  background: linear-gradient(155deg, #f4f4f8 0%, #ebebf0 50%, #e4e4ea 100%);
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  min-height: 148rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

/* 数字：大号底纹，极浅灰，不抢标题 */
.grid-card-num {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  font-size: 80rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.04);
  line-height: 1;
  z-index: 0;
}

/* 标题：唯一视觉重心，加粗 */
.grid-card-text {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.48;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-weight: 700;
}

/* 角标：半透明渐变 + 对角圆角 + 字间距 */
.grid-card-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 0 20rpx 0 12rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  z-index: 2;
}

.grid-card-badge-must {
  background: linear-gradient(135deg, rgba(18, 150, 219, 0.18) 0%, rgba(18, 150, 219, 0.06) 100%);
  color: #0d7ab8;
}

.grid-card-badge-hot {
  background: linear-gradient(135deg, rgba(220, 53, 69, 0.18) 0%, rgba(220, 53, 69, 0.06) 100%);
  color: #c73e4d;
}

/* ========== 分类 Tab ========== */
.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.category-tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.category-tab.active {
  color: #002fa7;
  background: rgba(0, 47, 167, 0.08);
  font-weight: 500;
}

/* ========== FAQ 列表（简约卡片流） ========== */
.qa-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.qa-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: none;
}

.question-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  min-height: 48rpx;
}

.question-num-wrap {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 50%;
}

.question-num {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.question-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.4;
}

.chevron-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chevron {
  font-size: 36rpx;
  color: #999;
  font-weight: 300;
  transform: rotate(0deg);
  transition: transform 0.25s ease;
  display: inline-block;
}

.chevron-down {
  transform: rotate(90deg);
}

.answer-wrap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.answer-visible {
  max-height: 2000rpx;
}

.answer-inner {
  padding: 0 24rpx 28rpx 88rpx;
  border-top: 1rpx solid #f0f0f0;
}

.answer-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999;
}

.bottom-spacer {
  height: 120rpx;
}

/* ========== 底部悬浮：联系客服（毛玻璃 + 克莱因蓝） ========== */
.contact-float {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.contact-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background: #002fa7;
  border: none;
  border-radius: 50rpx;
}

.contact-button::after {
  border: none;
}
