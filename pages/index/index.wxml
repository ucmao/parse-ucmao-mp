<view class="container index-page">
  <!-- 自定义导航栏：解决背景顶到红框区域的问题 -->
  <view class="custom-nav" style="height: {{statusBarHeight + navBarHeight}}px;">
    <view class="nav-title" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
      <image class="nav-title-img" src="../../images/title-index.png" mode="heightFix" />
    </view>
  </view>

  <!-- 顶部：猫咪管家工作台 -->
  <view class="dashboard-header">
    <view class="user-info-box">
      <image class="mini-avatar" src="../../images/logo.png" mode="aspectFit" />
      <view class="welcome-box">
        <text class="user-name">你好，{{nickName || '团团'}}</text>
        <text class="sub-slogan">{{subSlogan}}</text>
      </view>
    </view>
  </view>

  <view class="top-section">
    <!-- 输入区：增加了“厚度感”样式 -->
    <view class="input-wrap">
      <textarea
        placeholder="请复制分享的短视频链接到此处"
        bindinput="onInput"
        value="{{inputValue}}"
        class="input-box"
        disabled="{{isLoading}}"
      />
      <view wx:if="{{!inputValue && !isLoading}}" class="input-paste" bindtap="doPaste">
        <text class="input-paste-text">粘贴</text>
      </view>
      <view wx:elif="{{inputValue && !isLoading}}" class="input-clear" bindtap="clearInput">×</view>
    </view>

    <!-- 主操作：渐变色 + 向右箭头 -->
    <button
      class="main-btn {{isLoading ? 'loading' : ''}}"
      bindtap="onSubmit"
      disabled="{{isButtonDisabled}}"
    >
      <view wx:if="{{!isLoading}}" class="btn-content">
        <text>喵去水印（免费）</text>
        <text class="btn-arrow">→</text>
      </view>
      <view wx:else class="loading-inner">
        <text class="loading-dot">·</text><text class="loading-dot">·</text><text class="loading-dot">·</text>
      </view>
    </button>
  </view>

  <!-- 结果区：卡片式封装 -->
  <view class="result-section" wx:if="{{showWhiteBackground}}">
    <view class="result-card">
      <!-- 视频预览/封面 -->
      <view class="video-block" wx:if="{{showVideo || showCoverButton}}">
        <view class="video-glass-label">{{response.platform || '视频素材'}}</view>
        <image 
          wx:if="{{showCoverButton && !showVideo}}" 
          class="result-video" 
          src="{{response.cover_url}}" 
          mode="aspectFill" 
          bindtap="viewCoverImage"
        />
        <video 
          wx:if="{{showVideo}}" 
          class="result-video" 
          src="{{response.video_url}}" 
          poster="{{response.cover_url}}"
          controls
        />
      </view>

      <!-- 标题内容 -->
      <view class="title-block" wx:if="{{showArticle}}">
        <text class="title-label">文案内容</text>
        <text class="title-content" selectable>{{response.title}}</text>
      </view>

      <!-- 操作矩阵：三个主操作，长方形，前两个 logo 蓝、分享深色 -->
      <view class="action-matrix">
        <view class="action-row">
          <button class="action-btn btn-save" bindtap="downloadVideo" wx:if="{{showSaveVideoButton}}">
            <image class="action-btn-icon" src="../../images/download_vid.png" />
            <text>保存视频</text>
          </button>
          <button class="action-btn btn-save" bindtap="downloadCover" wx:if="{{showSaveCoverButton}}">
            <image class="action-btn-icon" src="../../images/download_img.png" />
            <text>保存封面</text>
          </button>
          <button class="action-btn btn-share" open-type="share">
            <image class="action-btn-icon" src="../../images/share-icon.png" />
            <text>分享好友</text>
          </button>
        </view>
      </view>

      <!-- 底部链接复制 -->
      <view class="copy-links">
        <text class="copy-link" bindtap="copyTitle">复制标题</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" bindtap="copyCoverUrl">复制封面</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" bindtap="copyVideoUrl">复制视频</text>
        <text class="copy-sep">|</text>
        <text class="copy-link" bindtap="copyAllInfo">复制全部</text>
      </view>
    </view>
  </view>
  
  <!-- 底部卡片：使用指南 -->
  <view class="footer-card" bindtap="navigateToQuestions">
    <view class="footer-card-left">
      <text class="footer-card-title">使用指南 & 常见问题</text>
      <text class="footer-card-desc">解决解析失败、保存失败等问题</text>
    </view>
    <view class="footer-card-right">
      <image src="../../images/cat.webp" class="footer-cat-peek" mode="aspectFit" />
    </view>
  </view>
</view>
